" --- General ---

set nocompatible
set encoding=utf-8

let mapleader = ' '
let maplocalleader = ' '

set mouse=a
set wildmenu
set wildmode=longest:full,full
set nolazyredraw
set noshowmatch
set timeoutlen=300
set updatetime=200
set confirm

" Disable audible and visual bells
set noerrorbells
set novisualbell
set belloff=all

" --- Appearance ---

set background=dark
set notermguicolors

syntax enable

" Preserve the terminal's transparent background
function! s:transparent_background() abort
  for group in ['Normal', 'NonText', 'SignColumn', 'LineNr', 'EndOfBuffer', 'FoldColumn']
    execute 'highlight' group 'guibg=NONE ctermbg=NONE'
  endfor
endfunction

augroup TransparentColors
  autocmd!
  autocmd ColorScheme,VimEnter * call <SID>transparent_background()
augroup END

colorscheme retrobox

set number
set relativenumber
set numberwidth=4
set signcolumn=yes
set scrolloff=8
set sidescrolloff=8
set colorcolumn=120
set nocursorline
set conceallevel=0

set laststatus=2
set ruler
set showmode
set showtabline=2
set pumheight=10
set completeopt=menu,menuone,noselect

set list
set listchars=tab:»\ ,trail:·,nbsp:␣

set foldmethod=indent
set foldlevel=99
set splitbelow
set splitright
set winminwidth=5

if exists('+smoothscroll')
  set smoothscroll
endif

if exists('+splitkeep')
  set splitkeep=screen
endif

set fillchars=eob:\ ,fold:\ ,diff:-

" --- Clipboard ---

if has('clipboard') && empty($SSH_CONNECTION)
  if has('win32') || has('win64') || has('win32unix')
    set clipboard=unnamed
  else
    set clipboard=unnamedplus
  endif
endif

" --- Searching ---

set hlsearch
set incsearch
set ignorecase
set smartcase

if executable('rg')
  set grepprg=rg\ --vimgrep
  set grepformat=%f:%l:%c:%m
endif

" --- Formatting ---

let g:markdown_recommended_style = 0
filetype plugin indent on

set wrap
set linebreak
set breakindent
set autoindent
set smartindent
set tabstop=2
set softtabstop=0
set shiftwidth=2
set shiftround
set expandtab
set formatoptions=jcroqlnt
set spelllang=en
set virtualedit=block

" --- File Handling ---

set autoread
set autowrite
set nobackup
set nowritebackup
set noswapfile
set isfname+=@-@

set undofile
set undolevels=10000
let &undodir = expand('~/.vim/undodir/vim')

if !isdirectory(&undodir)
  call mkdir(&undodir, 'p')
endif

" --- Autocommands ---

augroup CustomAutocmds
  autocmd!

  " Reset paste mode
  autocmd InsertLeave * set nopaste

  " Check for external file changes
  autocmd FocusGained * checktime

  " Equalize splits on resize
  autocmd VimResized * wincmd =

  " Restore previous cursor position
  autocmd BufReadPost *
        \ if &filetype !=# 'gitcommit'
        \ && line("'\"") > 0
        \ && line("'\"") <= line('$') |
        \   execute 'normal! g`"' |
        \ endif

  " Close utility windows with q
  autocmd FileType help,qf,man
        \ nnoremap <silent> <buffer> q <Cmd>close<CR>

  " Enable spell checking for prose
  autocmd FileType text,markdown,gitcommit,plaintex,typst
        \ setlocal wrap spell
augroup END

" --- Keymaps ---

" Move by visual lines unless a count is provided
nnoremap <expr> j v:count == 0 ? 'gj' : 'j'
nnoremap <expr> k v:count == 0 ? 'gk' : 'k'
nnoremap <expr> <Down> v:count == 0 ? 'gj' : 'j'
nnoremap <expr> <Up> v:count == 0 ? 'gk' : 'k'

xnoremap <expr> j v:count == 0 ? 'gj' : 'j'
xnoremap <expr> k v:count == 0 ? 'gk' : 'k'
xnoremap <expr> <Down> v:count == 0 ? 'gj' : 'j'
xnoremap <expr> <Up> v:count == 0 ? 'gk' : 'k'

" Scroll and center
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Line boundaries
nnoremap B ^
nnoremap E $

" Move lines
nnoremap J <Cmd>execute 'move .+' . v:count1<CR>==
nnoremap K <Cmd>execute 'move .-' . (v:count1 + 1)<CR>==
xnoremap J :move '>+1<CR>gv=gv
xnoremap K :move '<-2<CR>gv=gv

nmap <A-j> J
nmap <A-k> K
xmap <A-j> J
xmap <A-k> K
inoremap <A-j> <Esc><Cmd>move .+1<CR>==gi
inoremap <A-k> <Esc><Cmd>move .-2<CR>==gi

" Keep the visual selection after indentation
xnoremap < <gv
xnoremap > >gv

" Delete and change without affecting registers
nnoremap x "_x
xnoremap x "_x
nnoremap X "_X
xnoremap X "_X
nnoremap c "_c
xnoremap c "_c
nnoremap C "_C
xnoremap C "_C
nnoremap s "_s
xnoremap s "_s
nnoremap S "_S
xnoremap S "_S

" Paste without overwriting the default register
xnoremap p "_dP

" Exit insert mode
inoremap jk <Esc>
inoremap kj <Esc>
inoremap <C-c> <Esc>

" Undo breakpoints
inoremap , ,<C-g>u
inoremap . .<C-g>u
inoremap ; ;<C-g>u

" Search navigation
nnoremap <expr> n 'Nn'[v:searchforward] . 'zzzv'
nnoremap <expr> N 'nN'[v:searchforward] . 'zzzv'

xnoremap <expr> n 'Nn'[v:searchforward]
xnoremap <expr> N 'nN'[v:searchforward]

onoremap <expr> n 'Nn'[v:searchforward]
onoremap <expr> N 'nN'[v:searchforward]

" Clear search highlighting and refresh
nnoremap <Esc> <Cmd>nohlsearch<CR><Esc>
inoremap <Esc> <Cmd>nohlsearch<CR><Esc>
nnoremap <leader>ur <Cmd>nohlsearch<Bar>diffupdate<Bar>normal! <C-l><CR>

" Files and saving
nnoremap <leader>fn <Cmd>enew<CR>
nnoremap <C-s> <Cmd>write<CR>
inoremap <C-s> <Cmd>write<CR>
xnoremap <C-s> <Cmd>write<CR>
snoremap <C-s> <Esc><Cmd>write<CR>
nnoremap <leader>qq <Cmd>qa<CR>

" Buffers
nnoremap <S-h> <Cmd>bprevious<CR>
nnoremap <S-l> <Cmd>bnext<CR>
nnoremap [b <Cmd>bprevious<CR>
nnoremap ]b <Cmd>bnext<CR>
nnoremap <leader>bb <Cmd>buffer #<CR>
nnoremap <leader>` <Cmd>buffer #<CR>
nnoremap <leader>bd <Cmd>bdelete<CR>
nnoremap <leader>bD <Cmd>bdelete!<CR>

" Windows
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <C-Up> <Cmd>resize +2<CR>
nnoremap <C-Down> <Cmd>resize -2<CR>
nnoremap <C-Left> <Cmd>vertical resize -2<CR>
nnoremap <C-Right> <Cmd>vertical resize +2<CR>

nnoremap <leader>w <C-w>
nnoremap <leader>- <C-w>s
nnoremap <leader><Bar> <C-w>v
nnoremap <leader>wd <C-w>c

" Tabs
nnoremap <Tab> <Cmd>tabnext<CR>
nnoremap <S-Tab> <Cmd>tabprevious<CR>
nnoremap <leader><Tab>l <Cmd>tablast<CR>
nnoremap <leader><Tab>o <Cmd>tabonly<CR>
nnoremap <leader><Tab>f <Cmd>tabfirst<CR>
nnoremap <leader><Tab><Tab> <Cmd>tabnew<CR>
nnoremap <leader><Tab>] <Cmd>tabnext<CR>
nnoremap <leader><Tab>[ <Cmd>tabprevious<CR>
nnoremap <leader><Tab>d <Cmd>tabclose<CR>

" Location and quickfix lists
nnoremap <leader>xl <Cmd>call <SID>toggle_loclist()<CR>
nnoremap <leader>xq <Cmd>call <SID>toggle_quickfix()<CR>

function! s:toggle_loclist() abort
  if getloclist(0, {'winid': 0}).winid
    lclose
  else
    lopen
  endif
endfunction

function! s:toggle_quickfix() abort
  if getqflist({'winid': 0}).winid
    cclose
  else
    copen
  endif
endfunction

nnoremap [q <Cmd>cprevious<CR>
nnoremap ]q <Cmd>cnext<CR>

" Toggle options
nnoremap <leader>us <Cmd>setlocal spell!<CR>
nnoremap <leader>uw <Cmd>setlocal wrap!<CR>
nnoremap <leader>uL <Cmd>setlocal relativenumber!<CR>
nnoremap <leader>ul <Cmd>setlocal number!<CR>

" Terminal windows
if has('terminal')
  tnoremap <C-/> <C-w>:close!<CR>
  tnoremap <C-_> <C-w>:close!<CR>
endif

" Lazygit
if executable('lazygit')
  nnoremap <leader>gg <Cmd>!lazygit<CR>
  nnoremap <leader>gG <Cmd>!lazygit<CR>
endif

" Documentation
nnoremap <leader>K <Cmd>normal! K<CR>
