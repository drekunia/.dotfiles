{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#F2C6AC",
      "2": "#51382F",
      "3": "#D6A0A5",
      "4": "#66776A"
    },
    "padding": {
      "right": 2
    }
  },
  "general": {},
  "display": {
    "disableLinewrap": true,
    "separator": "",
    "key": {
      "width": 16
    },
    "constants": [
      "",
      "",
      "\u001b[90m│                                                            │\u001b[60D\u001b[39m"
    ]
  },
  "modules": [
    {
      "type": "custom",
      "key": "{#90}{$1}╭─────────────╮",
      "format": "{#90}{$2}╭────────────────────────────────────────────────────────────╮"
    },
    {
      "type": "datetime",
      "key": "{#90}{$1}│ {#92}Datetime    {#90}│",
      "format": "{$2}{$3} {year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty} {#2}{weekday:-9} UTC{offset-from-utc}"
    },
    {
      "type": "users",
      "key": "{#90}{$1}│ {#92}Login time  {#90}│",
      "format": "{$2}{$3} {login-time:-52}"
    },
    {
      "type": "uptime",
      "key": "{#90}{$1}│ {#92}Uptime      {#90}│",
      "format": "{$2}{$3} {days}d {hours}h {minutes}m {seconds}s"
    },
    {
      "type": "host",
      "key": "{#90}{$1}│ {#93}Machine     {#90}│",
      "format": "{$2}{$3} {name:-34} {version:-17}"
    },
    {
      "type": "os",
      "key": "{#90}{$1}│ {#93}OS          {#90}│",
      "format": "{$2}{$3} {pretty-name:-39} {#2}{arch:-9}"
    },
    {
      "type": "kernel",
      "key": "{#90}{$1}│ {#93}Kernel      {#90}│",
      "format": "{$2}{$3} {sysname} {release:-47}"
    },
    {
      "type": "cpu",
      "key": "{#90}{$1}│ {#91}CPU         {#90}│",
      "format": "{$2}{$3} {name:-51}"
    },
    {
      "type": "gpu",
      "key": "{#90}{$1}│ {#91}GPU {index}       {#90}│",
      "format": "{$2}{$3} {name:-37} {#2}({type:-12})"
    },
    {
      "type": "memory",
      "key": "{#90}{$1}│ {#91}Memory      {#90}│",
      "format": "{$2}{$3} {used} / {total} ({percentage}{$2})"
    },
    {
      "type": "disk",
      "key": "{#90}{$1}│ {#91}Disk {index}      {#90}│",
      "format": "{$2}{$3} {mountpoint:-12} {size-used} / {size-total} ({size-percentage}{$2})",
      "folders": "/:/mnt/c:/mnt/d"
    },
    {
      "type": "terminal",
      "key": "{#90}{$1}│ {#95}Terminal    {#90}│",
      "format": "{$2}{$3} {pretty-name:-35} {version:-14}"
    },
    {
      "type": "shell",
      "key": "{#90}{$1}│ {#95}Shell       {#90}│",
      "format": "{$2}{$3} {exe-name:-35} {version:-14}"
    },
    {
      "type": "wm",
      "key": "{#90}{$1}│ {#95}WM          {#90}│",
      "format": "{$2}{$3} {pretty-name:-33} {version:-10} {#2}({protocol-name:-9})"
    },
    {
      "type": "custom",
      "key": "{#90}{$1}╰─────────────╯",
      "format": "{#90}{$2}╰────────────────────────────────────────────────────────────╯"
    }
  ]
}
